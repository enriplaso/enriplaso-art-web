NEXT_PUBLIC_API_URL="http://localhost:3001"
# Optional: the API address as seen from the Next.js server, if it differs
# from the public one (e.g. a private network hostname in production). All
# API calls happen server-side, so this is the one actually used when set.
# API_URL="http://api.internal:3001"

# Public URL of the site, used for canonical/hreflang links and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Must match the API's STORAGE_PUBLIC_URL_BASE: next/image only optimizes
# images from this host. Defaults to the local MinIO bucket.
NEXT_PUBLIC_IMAGE_BASE_URL="http://localhost:9000/art-shop-images"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mirrors the backend's SHOP_ENABLED (see README's "Feature flag" section).
# NEXT_PUBLIC_ prefix is required for Next.js to expose it to client components.
NEXT_PUBLIC_SHOP_ENABLED=false
