# Matches docker-compose.yml at the repo root — `docker compose up -d`
# gives you a working Postgres for local dev with this exact connection string.
DATABASE_URL="postgresql://art_shop:art_shop@localhost:5432/art_shop?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
NODE_ENV=development

# Admin auth (see README's "Admin authentication" section). Generate one
# with: openssl rand -base64 48
JWT_SECRET=

# SHOP_ENABLED gates checkout/order endpoints server-side (see README's
# "Feature flag: SHOP_ENABLED" section).
SHOP_ENABLED=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin sale notifications (see README's "Admin notifications" section)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Product image storage (see README's "Image storage" section). One
# S3-compatible client works against any of these providers — only the
# values below change. This default matches the MinIO service in
# docker-compose.yml, so `docker compose up -d` gives you a working local
# object store with no extra setup.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="art-shop-images"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL_BASE="http://localhost:9000/art-shop-images"
